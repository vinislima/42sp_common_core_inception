## @file my.cnf
## @brief Inception-specific overrides for the MariaDB server.
## @note Loaded last (99- prefix) from /etc/mysql/mariadb.conf.d/, after
##       Debian's own defaults (data dir, socket, pid file, etc.).
[mysqld]
## @brief Listen on all interfaces so other containers on the "inception"
##        network (e.g. wordpress) can reach this service, not just localhost.
bind-address = 0.0.0.0

## @brief Skip reverse DNS lookups on incoming connections: faster connection
##        handling, and DNS is unnecessary inside an isolated Docker network.
skip-name-resolve
