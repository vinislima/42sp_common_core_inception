# Copie este arquivo para srcs/.env e ajuste os valores.
# srcs/.env NÃO é versionado (contém dados de configuração da sua VM).
# Nenhuma senha deve ficar aqui — senhas vão em ../secrets/*.txt (Docker secrets).

# --- Geral ---
DOMAIN_NAME=vinda-si.42.fr
NGINX_PORT=443

# --- MariaDB ---
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# --- WordPress ---
WP_TITLE=Inception
WP_ADMIN_USER=boss_vinda-si
WP_ADMIN_EMAIL=boss@vinda-si.42.fr
WP_USER=editor_vinda-si
WP_USER_EMAIL=editor@vinda-si.42.fr
